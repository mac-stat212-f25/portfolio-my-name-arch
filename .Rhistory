# use pmap()
# Let's create separate datasets within one tibble
by_clarity <- diamonds |>
group_nest(clarity)
by_clarity
# Create a variable with a image path
by_clarity <- by_clarity |>
mutate(path = str_glue("diamonds-{clarity}.png"))
