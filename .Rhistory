basketball <- read_csv("~/Documents/GitHub/portfolio-my-name-arch/src/tt/euroleague_basketball.csv")
# Calculate the total Final Four appearances for each country
country_summary <- basketball %>%
group_by(Country) %>%
summarize(Total_Appearances = sum(FinalFour_Appearances, na.rm = TRUE)) %>%
# Filter out countries with zero appearances to make the visual cleaner
filter(Total_Appearances > 0) %>%
# Arrange the data from most to least appearances
arrange(desc(Total_Appearances))
# Print the resulting summary table
print(country_summary)
basketball <- read_csv("~/Documents/GitHub/portfolio-my-name-arch/src/tt/euroleague_basketball.csv")
# Calculate the total Final Four appearances for each country
country_summary <- basketball %>%
group_by(Country) %>%
summarize(Total_Appearances = sum(FinalFour_Appearances, na.rm = TRUE)) %>%
# Filter out countries with zero appearances to make the visual cleaner
filter(Total_Appearances > 0) %>%
# Arrange the data from most to least appearances
arrange(desc(Total_Appearances))
# Print the resulting summary table
print(country_summary)
# Load the plotting library
library(ggplot2)
# Create the bar chart
ggplot(country_summary, aes(x = fct_reorder(Country, Total_Appearances), y = Total_Appearances)) +
geom_col(fill = "#00539B", alpha = 0.9) + # A nice basketball blue
coord_flip() + # Flips the axes to make country names readable
labs(
title = "A League of Their Own: Spanish Dominance in the Euroleague",
subtitle = "Total Final Four Appearances by Country Since 2000",
x = "Country",
y = "Total Final Four Appearances"
) +
theme_minimal(base_size = 14) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
plot.subtitle = element_text(hjust = 0.5),
panel.grid.major.y = element_blank(), # Removes horizontal grid lines
panel.grid.minor.x = element_blank()  # Removes minor vertical grid lines
)
