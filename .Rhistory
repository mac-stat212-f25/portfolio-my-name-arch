library(purrr)
library(stringr)
library(tibble)
# Create a tibble with varying arguments
varied_args <- tibble(
string = c("R-programming", "is-fun", "tidyverse"),
start  = c(3, 1, 6),
end    = c(13, 2, 9)
)
# Use pmap_chr() to apply str_sub() to each row
pmap_chr(varied_args, str_sub)
# Define the fixed string
my_string <- "Learning pmap is great!"
# Create a tibble with just the arguments that change
fixed_string_args <- tibble(
start = c(1, 10, 18),
end   = c(8, 13, 23)
)
# Pass the fixed string as an additional argument to pmap_chr()
pmap_chr(fixed_string_args, .f = str_sub, string = my_string)
