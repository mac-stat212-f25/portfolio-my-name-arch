# use pmap()
# Use pmap to create a list-column of models
df_models <- df_arg_combos |>
mutate(
model = pmap(
# The list of arguments that will vary with each iteration
.l = list(
mod_formula = mod_formula,
remove_outliers = remove_outliers
),
# The function to apply
.f = fit_model,
# Additional, fixed arguments to pass to the function
data = diamonds
)
)
# View the resulting tibble
df_models
